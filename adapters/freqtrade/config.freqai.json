{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "avax-context-engine-research",
  "strategy": "AvaxContextStrategy",
  "dry_run": true,
  "dry_run_wallet": 0,
  "trading_mode": "spot",
  "max_open_trades": 0,
  "stake_currency": "USDT",
  "stake_amount": 0,
  "tradable_balance_ratio": 0,
  "timeframe": "5m",
  "cancel_open_orders_on_exit": true,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "password": "",
    "pair_whitelist": ["AVAX/USDT", "BTC/USDT", "ETH/USDT"],
    "pair_blacklist": []
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false
  },
  "pairlists": [{"method": "StaticPairList"}],
  "freqai": {
    "enabled": true,
    "identifier": "avax-context-v0",
    "train_period_days": 180,
    "backtest_period_days": 14,
    "live_retrain_hours": 0,
    "purge_old_models": 4,
    "feature_parameters": {
      "include_timeframes": ["5m", "15m", "1h", "4h"],
      "include_corr_pairlist": ["BTC/USDT", "ETH/USDT"],
      "include_shifted_candles": 6,
      "indicator_periods_candles": [9, 14, 20, 50, 100, 200],
      "label_period_candles": 10,
      "principal_component_analysis": false,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.0,
      "shuffle": false
    },
    "model_training_parameters": {}
  },
  "initial_state": "stopped",
  "force_entry_enable": false
}
