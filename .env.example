# Read-only v1. No trading keys are required.
VITE_API_BASE=http://localhost:8000
ACE_DATA_DIR=./data
ACE_JOURNAL_PATH=./data/journal.sqlite3
# Set to 1 only for the sealed September fixture. Default is live Binance Vision.
# A failed live pull returns HTTP 503 and does not seed the fixture.
AVAX_USE_FIXTURE=0
# Closed 5m history on first live pull (10–180, default 90). Incremental refresh stays from last bar.
AVAX_LIVE_LOOKBACK_DAYS=90
