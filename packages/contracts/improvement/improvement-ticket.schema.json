{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avax-context-engine.local/contracts/improvement/improvement-ticket.schema.json",
  "title": "ImprovementTicket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "residual",
    "hypothesis",
    "write_scope",
    "forbidden_scope",
    "metrics_gate",
    "regressions",
    "status",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^IMP-[0-9]{3,}$" },
    "residual": { "type": "string", "minLength": 8 },
    "hypothesis": { "type": "string", "minLength": 8 },
    "write_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "forbidden_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "depends_on_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depends_on_access": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "validation",
        "primary_metric",
        "baseline_ids",
        "must_not"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 3 },
        "validation": { "type": "string", "enum": ["walk_forward", "shadow_live"] },
        "primary_metric": { "type": "string", "minLength": 3 },
        "baseline_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "n_min": { "type": "integer", "minimum": 1 },
        "leverage_sim": { "type": "boolean" },
        "must_not": { "type": "string", "minLength": 8 }
      }
    },
    "regressions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "blocked-on-access", "in-progress", "awaiting-outcome", "closed"]
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
