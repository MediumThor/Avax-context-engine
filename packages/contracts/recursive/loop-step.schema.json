{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avax-context-engine.local/contracts/recursive/loop-step.schema.json",
  "title": "LoopStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "t",
    "kind",
    "harness_version",
    "input_token_hash",
    "encoder_memory_hash",
    "state_in_hash",
    "state_out_hash",
    "swa_in_hash",
    "swa_out_hash",
    "tool",
    "emit",
    "citations",
    "exact",
    "latency_ms"
  ],
  "properties": {
    "t": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "ENCODE_CHECK",
        "RETRIEVE",
        "SYNTHESIZE",
        "CHALLENGE",
        "FORECAST_REFINE",
        "INVALIDATION_CHECK",
        "ANALOG",
        "NO_CHANGE",
        "HALT",
        "JOURNAL"
      ]
    },
    "harness_version": { "type": "string", "minLength": 1 },
    "input_token_hash": { "$ref": "#/$defs/sha256" },
    "encoder_memory_hash": { "$ref": "#/$defs/sha256" },
    "state_in_hash": { "$ref": "#/$defs/sha256" },
    "state_out_hash": { "$ref": "#/$defs/sha256" },
    "swa_in_hash": { "$ref": "#/$defs/sha256" },
    "swa_out_hash": { "$ref": "#/$defs/sha256" },
    "tool": {
      "type": ["object", "null"],
      "required": [
        "name",
        "request",
        "response_hash",
        "as_of",
        "refused",
        "refusal_reason"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "request": { "type": "object" },
        "response_hash": { "type": ["string", "null"] },
        "as_of": { "type": "string", "format": "date-time" },
        "refused": { "type": "boolean" },
        "refusal_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "emit": { "type": ["object", "null"] },
    "citations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exact": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
