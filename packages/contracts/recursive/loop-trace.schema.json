{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avax-context-engine.local/contracts/recursive/loop-trace.schema.json",
  "title": "LoopTrace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "symbol",
    "as_of",
    "encoder_memory_id",
    "encoder_memory_hash",
    "context_snapshot_id",
    "forecast_package_id",
    "harness_version",
    "tool_schema_version",
    "commit_sha",
    "warm_start_from_trace_id",
    "steps",
    "final_state",
    "halt",
    "content_hash",
    "journaled_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "1" },
    "symbol": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "encoder_memory_id": { "type": "string", "minLength": 1 },
    "encoder_memory_hash": { "$ref": "#/$defs/sha256" },
    "context_snapshot_id": { "type": "string", "minLength": 1 },
    "forecast_package_id": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string", "minLength": 1 },
    "tool_schema_version": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 1 },
    "warm_start_from_trace_id": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "final_state": { "type": "object" },
    "halt": { "type": "object" },
    "content_hash": { "$ref": "#/$defs/sha256" },
    "journaled_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
